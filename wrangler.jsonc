{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "property-scanner",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker runs first on EVERY path so pages and data files are behind the login too.
    "run_worker_first": true
  },
  // Per-IP rate limit for /api/* and /login (30 requests / 60 s per IP).
  "vars": { "REQUIRE_LOGIN": "false" },
  // Exact per-IP fixed window (30 req / 60 s) for /api/* and /login; API_LIMITER is the fallback.
  "durable_objects": { "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  // Persistent cache for /api/nearby and /api/walk upstream responses.
  "kv_namespaces": [{ "binding": "API_CACHE", "id": "251d9a5054e447f69e780bcb546b7540" }],
  // Private deal pipeline (names/contacts). Only reachable with a login session.
  "d1_databases": [{ "binding": "DEALS_DB", "database_name": "property-scanner-deals", "database_id": "b79ccd5f-12e8-4a0f-8c11-cd38557186ee", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ]
  // Secrets (set with `wrangler secret put <NAME>`, never commit them):
  //   APP_PASSWORD (only when REQUIRE_LOGIN=true); app refuses to serve without it)
  //   SESSION_SECRET            random string used to sign session cookies (recommended)
  //   GOOGLE_MAPS_API_KEY       Google Places (New) key for /api/nearby
  //   OPENROUTESERVICE_API_KEY  OpenRouteService key for /api/walk
  //
  // Optional persistent cache in KV (recommended on *.workers.dev, where the Cache API is a no-op):
  //   npx wrangler kv namespace create API_CACHE
  // then add:
  //   "kv_namespaces": [{ "binding": "API_CACHE", "id": "<id printed above>" }]
}
